{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devtoolbox",
  "compatibility_date": "2026-08-28",

  // Pure static-asset deployment — no Worker script. Vite's build output
  // (dist/) already contains a real, pre-rendered index.html per route
  // (see scripts/build-seo.ts), so those are served directly with their
  // own SEO metadata and never need a rewrite rule.
  //
  // "404-page" serves dist/404.html (also generated by build-seo.ts) with a
  // genuine HTTP 404 status for any path with no matching file. Every real
  // route this app has is always prerendered by build-seo.ts, so there's
  // never a legitimate client-only route that needs the SPA-fallback mode —
  // using it here would instead make bad/typo URLs return 200 with the
  // homepage's indexable content (a "soft 404", bad for SEO). 404.html loads
  // the same JS bundle, so React Router's own NotFoundPage still renders
  // once the page hydrates.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
