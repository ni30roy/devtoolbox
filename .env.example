# Copy this file to .env.production.local (untracked — see .gitignore's
# "*.local" rule) for a local production build, or set VITE_SITE_URL as an
# environment variable in your hosting provider's dashboard instead.
#
# Absolute origin the site is deployed at. No trailing slash. Used to build
# canonical URLs, sitemap.xml, robots.txt, Open Graph/Twitter tags, and
# JSON-LD across the whole site (see src/lib/site.ts).
VITE_SITE_URL=https://your-production-domain.example
